# Build-time networking is operator-controlled; runtime networking is always disabled.
ARG BASE_IMAGE
# Single-ID hosts (one UID, no _apt/nobody) pass --build-arg APT_SANDBOX_USER=root.
# The default empty value keeps the stock apt sandbox untouched elsewhere.
ARG APT_SANDBOX_USER=""
FROM ${BASE_IMAGE}
# ARG before FROM is out of scope for the stage; redeclare to use it below.
ARG APT_SANDBOX_USER=""
USER root
RUN if [ -n "$APT_SANDBOX_USER" ]; then OPT="-o APT::Sandbox::User=$APT_SANDBOX_USER"; fi \
 && apt-get $OPT update \
 && apt-get $OPT install -y --no-install-recommends git make gcc g++ ripgrep ca-certificates \
 && rm -rf /var/lib/apt/lists/*
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /workspace
ENTRYPOINT ["/bin/sh"]
